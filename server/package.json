{
  "name": "@abyss/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "questions:check": "tsx scripts/check-questions.ts"
  },
  "dependencies": {
    "@abyss/shared": "*",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "esbuild": "^0.25.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
